import { CheckBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct TunnelData {
    id: string,
    name: string,
    local_port: string,
    proxy_host: string,
    proxy_port: string,
    proxy_username: string,
    save_proxy_password: bool,
    rsa_key_path: string,

    target_host: string,
    target_port: string,
    auto_connect: bool,
    is_running: bool,
    is_reconnecting: bool,
    uptime: string,
    tx_rx: string,
    signal: int,
}

export struct AppSettings {
    connection_timeout: string,
    minimize_to_tray: bool,
    start_on_boot: bool,
}

export global Palette {
    out property <color> bg-dark:      #181A22;
    out property <color> sidebar:      #1B1D27;
    out property <color> card:         #22242F;
    out property <color> text-main:    #F0F2FF;
    out property <color> text-sub:     #8B8FA8;
    out property <color> accent:       #3EADFF;
    out property <color> accent-dark:  #1E7ADE;
    out property <color> active-green: #34D47F;
    out property <color> reconnect-yellow: #FADB5F;
    out property <color> inactive:     #4A4D60;
    out property <color> border:       #2E3044;
    out property <color> border-light: #3A3D55;
}

// â”€â”€ Play icon (right-pointing triangle) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
component PlayIcon inherits Path {
    in property <color> icon-color: Palette.text-sub;
    fill: icon-color;
    width: 12px; height: 13px;
    commands: "M 0 0 L 12 6.5 L 0 13 Z";
}

// â”€â”€ Stop icon (filled square) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
component StopIcon inherits Path {
    in property <color> icon-color: Palette.text-sub;
    fill: icon-color;
    width: 11px; height: 11px;
    commands: "M 0 0 L 11 0 L 11 11 L 0 11 Z";
}

// â”€â”€ Edit / pencil icon â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
component EditIcon inherits Path {
    in property <color> icon-color: Palette.text-sub;
    fill: transparent;
    stroke: icon-color;
    stroke-width: 1.4px;
    width: 14px; height: 14px;
    commands: "M 10 1 L 13 4 L 4 13 L 1 13 L 1 10 Z M 8.5 2.5 L 11.5 5.5";
}

// ── Copy / duplicate icon (two overlapping pages) ─────────────────────────
component CopyIcon inherits Path {
    in property <color> icon-color: Palette.text-sub;
    fill: transparent;
    stroke: icon-color;
    stroke-width: 1.4px;
    width: 14px; height: 14px;
    commands: "M 5 0 L 13 0 L 13 8 L 5 8 Z M 1 4 L 9 4 L 9 12 L 1 12 Z";
}

// ── Delete / trash icon ──────────────────────────────────────────────────
component DeleteIcon inherits Path {
    in property <color> icon-color: Palette.text-sub;
    fill: transparent;
    stroke: icon-color;
    stroke-width: 1.4px;
    width: 14px; height: 14px;
    commands: "M 2 3 L 12 3 M 5 3 L 5 1 L 9 1 L 9 3 M 3 3 L 4 13 L 10 13 L 11 3 M 6 6 L 6 10 M 8 6 L 8 10";
}

// ── Three vertical dots for "more" ──────────────────────────────────────
component MoreIcon inherits Rectangle {
    in property <color> icon-color: Palette.text-sub;
    background: transparent;
    width: 4px; height: 18px;

    Rectangle { x: 0px; y: 1px;  width: 4px; height: 4px; border-radius: 2px; background: icon-color; }
    Rectangle { x: 0px; y: 7px;  width: 4px; height: 4px; border-radius: 2px; background: icon-color; }
    Rectangle { x: 0px; y: 13px; width: 4px; height: 4px; border-radius: 2px; background: icon-color; }
}

// ── Network / graph icon for sidebar brand ──────────────────────────────
component NetworkIcon inherits Rectangle {
    in property <color> icon-color: Palette.accent;
    background: transparent;
    width: 24px; height: 24px;

    Path {
        fill: transparent;
        stroke: icon-color;
        stroke-width: 1.5px;
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        commands: "M 12 12 L 12 4 M 12 12 L 4 10 M 12 12 L 7 20 M 12 12 L 19 16 M 12 4 L 4 10 M 4 10 L 7 20 M 7 20 L 19 16 M 12 4 L 19 16";
    }
    // Node circles
    Rectangle { x: parent.width * (7.5/24); y: parent.height * (7.5/24); width: parent.width * (9/24); height: parent.height * (9/24); border-radius: self.width/2; background: Palette.bg-dark; border-width: 2px; border-color: icon-color; }
    Rectangle { x: parent.width * (10/24); y: parent.height * (1/24); width: parent.width * (6/24); height: parent.height * (6/24); border-radius: self.width/2; background: Palette.bg-dark; border-width: 1.5px; border-color: icon-color; }
    Rectangle { x: parent.width * (1/24); y: parent.height * (7/24); width: parent.width * (6/24); height: parent.height * (6/24); border-radius: self.width/2; background: Palette.bg-dark; border-width: 1.5px; border-color: icon-color; }
    Rectangle { x: parent.width * (4/24); y: parent.height * (17/24); width: parent.width * (6/24); height: parent.height * (6/24); border-radius: self.width/2; background: Palette.bg-dark; border-width: 1.5px; border-color: icon-color; }
    Rectangle { x: parent.width * (17/24); y: parent.height * (14/24); width: parent.width * (6/24); height: parent.height * (6/24); border-radius: self.width/2; background: Palette.bg-dark; border-width: 1.5px; border-color: icon-color; }
}

// â”€â”€ Gear icon using Path â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
component GearIcon inherits Rectangle {
    in property <color> icon-color: Palette.text-sub;
    background: transparent;
    width: 20px; height: 20px;

    Path {
        fill: icon-color;
        width: 20px; height: 20px;
        // Simplified gear: outer ring + 8 teeth stubs
        commands: "M 8 0 L 9 0 L 10 2 Q 11.5 2.3 12.8 3 L 14.5 2 L 15.5 3 L 14.5 4.7 Q 15.2 6 15.5 7.5 L 17.5 8 L 17.5 9 L 15.5 9.5 Q 15.2 11 14.5 12.3 L 15.5 14 L 14.5 15 L 12.8 14 Q 11.5 14.7 10 15 L 9 17 L 8 17 L 7 15 Q 5.5 14.7 4.2 14 L 2.5 15 L 1.5 14 L 2.5 12.3 Q 1.8 11 1.5 9.5 L -0.5 9 L -0.5 8 L 1.5 7.5 Q 1.8 6 2.5 4.7 L 1.5 3 L 2.5 2 L 4.2 3 Q 5.5 2.3 7 2 Z M 5.5 8.5 A 3 3 0 1 0 11.5 8.5 A 3 3 0 1 0 5.5 8.5";
    }
}

// â”€â”€ Info circle icon â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
component InfoIcon inherits Rectangle {
    in property <color> icon-color: Palette.text-sub;
    background: transparent;
    width: 20px; height: 20px;

    // Outer circle
    Path {
        fill: transparent;
        stroke: icon-color;
        stroke-width: 1.5px;
        width: 20px; height: 20px;
        commands: "M 10 1 A 9 9 0 1 0 10.001 1 Z";
    }
    // "i" dot and stem
    Rectangle { x: 9px; y: 5px; width: 2px; height: 2px; border-radius: 1px; background: icon-color; }
    Rectangle { x: 9px; y: 9px; width: 2px; height: 6px; border-radius: 1px; background: icon-color; }
}

// â”€â”€ Signal bars â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
component SignalBars inherits HorizontalLayout {
    in property <int> level;
    spacing: 3px;
    alignment: end;

    VerticalLayout { alignment: end; Rectangle { width: 4px; height: 8px;  border-radius: 1.5px; background: level >= 1 ? Palette.active-green : Palette.inactive; } }
    VerticalLayout { alignment: end; Rectangle { width: 4px; height: 11px; border-radius: 1.5px; background: level >= 2 ? Palette.active-green : Palette.inactive; } }
    VerticalLayout { alignment: end; Rectangle { width: 4px; height: 14px; border-radius: 1.5px; background: level >= 3 ? Palette.active-green : Palette.inactive; } }
    VerticalLayout { alignment: end; Rectangle { width: 4px; height: 17px; border-radius: 1.5px; background: level >= 4 ? Palette.active-green : Palette.inactive; } }
}

// â”€â”€ Icon button â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// kind: "play" | "stop" | "edit" | "copy" | "more"
component IconBtn inherits Rectangle {
    in property <string> kind;
    in property <bool>   highlighted: false;
    callback clicked;

    width: 36px; height: 36px;
    border-radius: 8px;
    background: touch.pressed ? Palette.border-light : (highlighted ? Palette.accent.with-alpha(0.15) : Palette.sidebar);
    border-width: 1.5px;
    border-color: highlighted ? Palette.accent : Palette.border;
    animate border-color, background { duration: 180ms; }

    if (kind == "play") : PlayIcon {
        icon-color: highlighted ? Palette.accent : Palette.text-sub;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if (kind == "stop") : StopIcon {
        icon-color: highlighted ? Palette.accent : Palette.text-sub;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if (kind == "edit") : EditIcon {
        icon-color: Palette.text-sub;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if (kind == "copy") : CopyIcon {
        icon-color: Palette.text-sub;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if (kind == "more") : MoreIcon {
        icon-color: Palette.text-sub;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if (kind == "delete") : DeleteIcon {
        icon-color: Palette.text-sub;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea { clicked => { root.clicked(); } }
}

// â”€â”€ Sidebar nav item â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// â”€â”€ Auto-Connect checkbox â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
component AutoConnectBox inherits HorizontalLayout {
    in-out property <bool> checked;
    callback toggled(bool);

    spacing: 7px;
    alignment: center;

    Rectangle {
        width: 16px; height: 16px;
        y: 10px;
        border-radius: 4px;
        border-width: 1.5px;
        border-color: checked ? Palette.accent : Palette.border-light;
        background: checked ? Palette.accent : transparent;
        animate border-color, background { duration: 150ms; }

        // Checkmark (only visible when checked) â€” drawn as two Path strokes
        if checked : Path {
            fill: transparent;
            stroke: white;
            stroke-width: 2px;
            width: 10px; height: 8px;
            x: 3px; y: 4px;
            commands: "M 0 4 L 3.5 7.5 L 10 0";
        }
        TouchArea { clicked => { root.checked = !root.checked; root.toggled(root.checked); } }
    }
    Text {
        text: "Auto-Connect";
        font-size: 12px;
        color: Palette.text-sub;
        vertical-alignment: center;
    }
}

// â”€â”€ Main window â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
export component AppWindow inherits Window {
    title: "rTunnel";
    icon: @image-url("../icon.png");
    preferred-width: 920px;
    preferred-height: 620px;
    background: Palette.bg-dark;
    default-font-family: "Segoe UI";

    callback show_window();

    in-out property <[TunnelData]> tunnels: [];
    in-out property <string>       selected_id: "";
    in-out property <TunnelData>   edit_data;
    in-out property <string>       search_text: "";
    in-out property <string>       active_tab: "tunnels";
    in-out property <AppSettings>  settings;
    
    in-out property <bool> engine_active: true;
    in-out property <int> active_tunnels_count: 0;
    in-out property <int> stopped_tunnels_count: 0;
    callback minimize_to_tray_clicked();

    callback start_tunnel(string, bool);
    callback stop_tunnel(string);
    callback save_config(TunnelData);
    callback save_settings(AppSettings);
    callback create_new();
    callback select_tunnel(string);
    callback copy_tunnel(string);
    callback delete_tunnel(string);
    callback toggle_auto_connect(string, bool);
    callback update_search();

    in-out property <bool>   show_password_prompt: false;
    in-out property <string> prompt_tunnel_id;
    in-out property <bool>   prompt_needs_proxy: false;
    property <string>        prompt_proxy_pass;

    in-out property <bool>   show_error_prompt: false;
    in-out property <string> error_message;
    callback show_error(string);
    callback submit_passwords(string, string, bool);

    in-out property <bool>   show_info_prompt: false;

    in-out property <bool>   show_host_key_prompt: false;
    in-out property <string> prompt_host_key_fingerprint;
    in-out property <string> prompt_host_key_line;
    in-out property <string> prompt_host_key_tunnel_id;
    in-out property <bool>   prompt_host_key_is_reconnect;

    callback accept_host_key(string, string, bool);
    callback reject_host_key();

    HorizontalLayout {

        // ── Sidebar ─────────────────────────────────────────────────────────────────
        Rectangle {
            width: 62px;
            background: Palette.sidebar;

            VerticalLayout {
                padding-top: 16px;
                padding-bottom: 16px;
                spacing: 2px;
                alignment: start;

                // Tunnels nav (active)
                Rectangle {
                    width: 62px; height: 48px;
                    background: active_tab == "tunnels" ? Palette.accent.with-alpha(0.10) : transparent;

                    // Active left bar
                    if active_tab == "tunnels" : Rectangle {
                        width: 3px; height: 26px;
                        x: 0px; y: 11px;
                        background: Palette.accent;
                        border-radius: 2px;
                    }
                    NetworkIcon {
                        icon-color: active_tab == "tunnels" ? Palette.accent : Palette.text-sub;
                        x: (parent.width - self.width) / 2 + (active_tab == "tunnels" ? 2px : 0px);
                        y: (parent.height - self.height) / 2;
                    }
                    TouchArea { clicked => { active_tab = "tunnels"; } }
                }

                // Settings nav
                Rectangle {
                    width: 62px; height: 48px;
                    background: active_tab == "settings" ? Palette.accent.with-alpha(0.10) : transparent;
                    
                    if active_tab == "settings" : Rectangle {
                        width: 3px; height: 26px;
                        x: 0px; y: 11px;
                        background: Palette.accent;
                        border-radius: 2px;
                    }

                    GearIcon {
                        icon-color: active_tab == "settings" ? Palette.accent : Palette.text-sub;
                        x: (parent.width - self.width) / 2 + (active_tab == "settings" ? 2px : 0px);
                        y: (parent.height - self.height) / 2;
                    }
                    TouchArea { clicked => { active_tab = "settings"; } }
                }

                Rectangle { vertical-stretch: 1; }

                // Info nav
                Rectangle {
                    width: 62px; height: 48px;
                    background: transparent;
                    InfoIcon {
                        icon-color: Palette.text-sub;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                    TouchArea { clicked => { show_info_prompt = true; } }
                }
            }
        }

        // Sidebar divider
        Rectangle { width: 1px; background: Palette.border; }

        // ── Main content ────────────────────────────────────────────────────────────
        VerticalLayout {

            // ── Header ───────────────────────────────────────────────────────────
            HorizontalLayout {
                padding-left: 32px;
                padding-right: 24px;
                padding-top: 28px;
                padding-bottom: 16px;

                Text {
                    text: active_tab == "tunnels" ? "Tunnels" : "Settings";
                    font-size: 32px;
                    font-family: "Roboto";
                    font-weight: 800;
                    color: Palette.text-main;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                // Search pill
                if active_tab == "tunnels" : Rectangle {
                    width: 235px; height: 36px;
                    border-radius: 18px;
                    background: Palette.card;
                    border-width: 1px;
                    border-color: Palette.border;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        alignment: start;

                        // Magnifier icon
                        Path {
                            fill: transparent;
                            stroke: Palette.text-sub;
                            stroke-width: 1.5px;
                            width: 14px; height: 14px;
                            y: (parent.height - self.height) / 2;
                            commands: "M 5.5 0 A 5.5 5.5 0 1 0 5.501 0 Z M 10 10 L 14 14";
                        }

                        TextInput {
                            text <=> search_text;
                            color: Palette.text-main;
                            font-size: 13px;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                            edited => { update_search(); }
                        }
                    }
                }
            }

            // ── Tunnel cards ────────────────────────────────────────────────────────────
            if active_tab == "tunnels" : ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    alignment: start;
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-bottom: 80px;
                    spacing: 14px;

                    for t in tunnels : Rectangle {
                        border-radius: 12px;
                        background: Palette.card;
                        border-width: 1px;
                        border-color: (t.is_running || t.is_reconnecting) ? Palette.accent.with-alpha(0.3) : Palette.border;
                        drop-shadow-color: (t.is_running || t.is_reconnecting) ? Palette.accent.with-alpha(0.10) : #00000030;
                        drop-shadow-blur: 14px;
                        drop-shadow-offset-y: 4px;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 12px;

                            // ── Status / name / controls row ────────────────────────
                            HorizontalLayout {
                                spacing: 10px;

                                // Status dot
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 11px; height: 11px;
                                        border-radius: 6px;
                                        background: t.is_running ? Palette.active-green : (t.is_reconnecting ? Palette.reconnect-yellow : Palette.inactive);
                                        drop-shadow-color: t.is_running ? Palette.active-green.with-alpha(0.65) : (t.is_reconnecting ? Palette.reconnect-yellow.with-alpha(0.65) : transparent);
                                        drop-shadow-blur: (t.is_running || t.is_reconnecting) ? 8px : 0px;
                                    }
                                }

                                // Status label
                                Text {
                                    text: t.is_running ? "ACTIVE" : (t.is_reconnecting ? "RECONNECTING" : "DISCONNECTED");
                                    color: t.is_running ? Palette.active-green : (t.is_reconnecting ? Palette.reconnect-yellow : Palette.inactive);
                                    font-size: 10.5px;
                                    font-weight: 800;
                                    vertical-alignment: center;
                                    width: 94px;
                                }

                                // Tunnel name
                                Text {
                                    text: t.name;
                                    font-size: 16px;
                                    font-weight: 700;
                                    color: Palette.text-main;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                // Auto-Connect checkbox
                                AutoConnectBox {
                                    checked: t.auto_connect;
                                    toggled(v) => { toggle_auto_connect(t.id, v); }
                                }

                                Rectangle { width: 6px; }

                                // Action buttons
                                HorizontalLayout {
                                    spacing: 7px;

                                    IconBtn {
                                        kind: (t.is_running || t.is_reconnecting) ? "stop" : "play";
                                        highlighted: (t.is_running || t.is_reconnecting);
                                        clicked => {
                                            if (t.is_running || t.is_reconnecting) { stop_tunnel(t.id); }
                                            else { start_tunnel(t.id, false); }
                                        }
                                    }

                                    IconBtn {
                                        kind: "edit";
                                        clicked => {
                                            if (selected_id == t.id) { selected_id = ""; }
                                            else { select_tunnel(t.id); }
                                        }
                                    }

                                    IconBtn { kind: "copy"; clicked => { copy_tunnel(t.id); } }
                                    IconBtn { kind: "delete"; clicked => { delete_tunnel(t.id); } }
                                    IconBtn { 
                                        kind: "more";
                                        clicked => {
                                            more_popup.show();
                                        }
                                        more_popup := PopupWindow {
                                            width: 140px;
                                            x: -100px;
                                            y: 40px;
                                            Rectangle {
                                                width: 100%; height: 100%;
                                                background: Palette.card;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: Palette.border;
                                                drop-shadow-color: #00000040;
                                                drop-shadow-blur: 10px;
                                                
                                                VerticalLayout {
                                                    padding: 4px;
                                                    
                                                    Rectangle {
                                                        height: 28px;
                                                        border-radius: 4px;
                                                        background: rsa_touch.has-hover ? Palette.sidebar : transparent;
                                                        Text { text: "Configure RSA Key"; color: Palette.text-main; font-size: 12px; vertical-alignment: center; x: 10px; }
                                                        rsa_touch := TouchArea {
                                                            clicked => {
                                                                if (selected_id != t.id) {
                                                                    select_tunnel(t.id);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // ── Route topology line ─────────────────────────
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                x: 21px;

                                Text {
                                    text: "Local: " + t.local_port + "   " + t.proxy_host;
                                    color: Palette.text-sub;
                                    font-size: 12.5px;
                                    vertical-alignment: center;
                                }

                                NetworkIcon {
                                    width: 16px; height: 16px;
                                    icon-color: t.is_running ? Palette.accent : (t.is_reconnecting ? Palette.reconnect-yellow : Palette.inactive);
                                }

                                Text {
                                    text: t.target_host + ":" + t.target_port;
                                    color: Palette.text-sub;
                                    font-size: 12.5px;
                                    vertical-alignment: center;
                                }
                            }

                            // Divider
                            Rectangle { height: 1px; background: Palette.border; }

                            // ── Telemetry row ───────────────────────────────
                            HorizontalLayout {
                                spacing: 10px;

                                Text {
                                    text: "Uptime: " + t.uptime;
                                    color: Palette.text-sub;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    width: 1px; height: 12px;
                                    background: Palette.border-light;
                                    y: 2px;
                                }
                                Text {
                                    text: "Data RX/TX: " + t.tx_rx;
                                    color: Palette.text-sub;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                SignalBars { level: t.signal; }
                            }

                            // ── Expanded edit form ────────────────────────
                            if (selected_id == t.id) : VerticalLayout {
                                spacing: 12px;
                                padding-top: 10px;

                                Rectangle { height: 1px; background: Palette.border; }

                                Text { text: "General"; font-weight: 700; color: Palette.text-main; font-size: 13px; }
                                HorizontalLayout { spacing: 10px; Text { text: "Name:"; width: 110px; vertical-alignment: center; color: Palette.text-sub; font-size: 13px; } LineEdit { text <=> edit_data.name; } }
                                HorizontalLayout { spacing: 10px; Text { text: "Local Port:"; width: 110px; vertical-alignment: center; color: Palette.text-sub; font-size: 13px; } LineEdit { text <=> edit_data.local_port; } }

                                Text { text: "Proxy SSH Server"; font-weight: 700; color: Palette.text-main; font-size: 13px; }
                                HorizontalLayout { spacing: 10px; Text { text: "Host:"; width: 110px; vertical-alignment: center; color: Palette.text-sub; font-size: 13px; } LineEdit { text <=> edit_data.proxy_host; } }
                                HorizontalLayout { spacing: 10px; Text { text: "Port:"; width: 110px; vertical-alignment: center; color: Palette.text-sub; font-size: 13px; } LineEdit { text <=> edit_data.proxy_port; } }
                                HorizontalLayout { spacing: 10px; Text { text: "Username:"; width: 110px; vertical-alignment: center; color: Palette.text-sub; font-size: 13px; } LineEdit { text <=> edit_data.proxy_username; } }
                                HorizontalLayout { spacing: 10px; CheckBox { text: "Save Password"; checked <=> edit_data.save_proxy_password; } }

                                Text { text: "Advanced (SSH)"; font-weight: 700; color: Palette.text-main; font-size: 13px; }
                                HorizontalLayout { spacing: 10px; Text { text: "RSA Key Path:"; width: 110px; vertical-alignment: center; color: Palette.text-sub; font-size: 13px; } LineEdit { text <=> edit_data.rsa_key_path; placeholder-text: "Optional (/path/to/id_rsa)"; } }


                                Text { text: "Target Destination"; font-weight: 700; color: Palette.text-main; font-size: 13px; }
                                HorizontalLayout { spacing: 10px; Text { text: "Host:"; width: 110px; vertical-alignment: center; color: Palette.text-sub; font-size: 13px; } LineEdit { text <=> edit_data.target_host; } }
                                HorizontalLayout { spacing: 10px; Text { text: "Port:"; width: 110px; vertical-alignment: center; color: Palette.text-sub; font-size: 13px; } LineEdit { text <=> edit_data.target_port; } }

                                HorizontalLayout {
                                    alignment: end;
                                    Rectangle {
                                        width: 160px; height: 36px;
                                        border-radius: 8px;
                                        background: save_config_touch.pressed ? Palette.accent-dark : @linear-gradient(135deg, Palette.accent, Palette.accent-dark);
                                        Text { text: "Save Configuration"; font-size: 13px; font-weight: 700; color: white; horizontal-alignment: center; vertical-alignment: center; }
                                        save_config_touch := TouchArea { clicked => { save_config(edit_data); selected_id = ""; } }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── Settings view ────────────────────────────────────────────────────────
            if active_tab == "settings" : ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    alignment: start;
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-bottom: 20px;
                    spacing: 14px;

                    Rectangle {
                        border-radius: 12px;
                        background: Palette.card;
                        border-width: 1px;
                        border-color: Palette.border;
                        
                        VerticalLayout {
                            padding: 24px;
                            spacing: 16px;

                            Text { text: "Application Settings"; font-weight: 700; color: Palette.text-main; font-size: 16px; }
                            
                            Rectangle { height: 1px; background: Palette.border; }

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "Connection Timeout (s):"; width: 160px; vertical-alignment: center; color: Palette.text-sub; font-size: 14px; }
                                LineEdit { text <=> settings.connection_timeout; width: 100px; }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                CheckBox { text: "Minimize to Tray on Close"; checked <=> settings.minimize_to_tray; }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                CheckBox { text: "Start on Boot"; checked <=> settings.start_on_boot; }
                            }

                            Rectangle { height: 20px; }
                            
                            HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    width: 140px; height: 36px;
                                    border-radius: 8px;
                                    background: save_settings_touch.pressed ? Palette.accent-dark : @linear-gradient(135deg, Palette.accent, Palette.accent-dark);
                                    Text { text: "Save Settings"; font-size: 13px; font-weight: 700; color: white; horizontal-alignment: center; vertical-alignment: center; }
                                    save_settings_touch := TouchArea { clicked => { save_settings(settings); } }
                                }
                            }
                        }
                    }
                }
            }

            // ── Status bar ───────────────────────────────────────────────────────────
            Rectangle { height: 1px; background: Palette.border; }
            Rectangle {
                height: 30px;
                background: Palette.sidebar;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;

                    Text { text: "rTunnel v0.2.0"; color: Palette.text-sub; font-size: 11px; vertical-alignment: center; }
                    Text { text: "|"; color: Palette.border-light; font-size: 11px; vertical-alignment: center; }
                    Text { text: root.engine_active ? "Connection Engine Active" : "Connection Engine Inactive"; color: Palette.text-sub; font-size: 11px; vertical-alignment: center; }
                    Text { text: "|"; color: Palette.border-light; font-size: 11px; vertical-alignment: center; }
                    Text { text: "Tunnels: " + root.active_tunnels_count + " Active, " + root.stopped_tunnels_count + " Stopped"; color: Palette.text-sub; font-size: 11px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    // Compact mode / resize icon (two overlapping squares)
                    Rectangle {
                        width: 14px; height: 14px;
                        y: (parent.height - self.height) / 2;
                        background: transparent;
                        Path {
                            fill: tray_touch.has-hover ? Palette.text-main : Palette.text-sub;
                            width: 100%; height: 100%;
                            commands: "M 0 4 L 10 4 L 10 14 L 0 14 Z M 4 0 L 14 0 L 14 10 L 4 10 Z";
                        }
                        tray_touch := TouchArea {
                            clicked => { root.minimize_to_tray_clicked(); }
                        }
                    }
                }
            }
        }
    }

    // â”€â”€ Floating Action Button â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    Rectangle {
        x: parent.width - 76px;
        y: parent.height - 96px;
        width: 54px; height: 54px;
        border-radius: 27px;
        background: fab_touch.pressed ? Palette.accent-dark : @linear-gradient(135deg, Palette.accent, Palette.accent-dark);

        // Plus icon
        Rectangle { x: 26px; y: 13px; width: 2px; height: 28px; background: white; border-radius: 1px; }
        Rectangle { x: 13px; y: 26px; width: 28px; height: 2px; background: white; border-radius: 1px; }

        fab_touch := TouchArea { clicked => { create_new(); } }
    }

    // â”€â”€ Password prompt overlay â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    if (show_password_prompt) : Rectangle {
        background: #00000099;
        TouchArea { }

        Rectangle {
            width: 360px; height: 260px;
            border-radius: 12px;
            background: Palette.card;
            border-width: 1px;
            border-color: Palette.border-light;
            drop-shadow-color: #00000060;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 10px;

            VerticalLayout {
                padding: 24px; spacing: 16px;

                Text { text: "Authentication Required"; font-weight: 700; color: Palette.text-main; font-size: 15px; }
                if (prompt_needs_proxy) : HorizontalLayout {
                    Text { text: "Proxy Pass:"; width: 100px; vertical-alignment: center; color: Palette.text-sub; font-size: 13px; }
                    LineEdit { input-type: password; text <=> prompt_proxy_pass; }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px; alignment: end;
                    Rectangle {
                        width: 80px; height: 34px;
                        border-radius: 8px; background: Palette.sidebar;
                        border-width: 1px; border-color: Palette.border;
                        Text { text: "Cancel"; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; color: Palette.text-sub; }
                        TouchArea { clicked => { show_password_prompt = false; } }
                    }
                    Rectangle {
                        width: 90px; height: 34px;
                        border-radius: 8px;
                        background: @linear-gradient(135deg, Palette.accent, Palette.accent-dark);
                        Text { text: "Connect"; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; color: white; }
                        TouchArea {
                            clicked => {
                                show_password_prompt = false;
                                submit_passwords(prompt_tunnel_id, prompt_proxy_pass, false);
                                prompt_proxy_pass = "";
                            }
                        }
                    }
                }
            }
        }
    }

    // â”€â”€ Error overlay â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    if (show_error_prompt) : Rectangle {
        background: #00000099;
        TouchArea { }

        Rectangle {
            width: 420px; height: 210px;
            border-radius: 12px;
            background: Palette.card;
            border-width: 1px; border-color: #ef4444;
            drop-shadow-color: #ef444440;
            drop-shadow-blur: 24px; drop-shadow-offset-y: 8px;

            VerticalLayout {
                padding: 24px; spacing: 14px;

                Text { text: "Connection Error"; font-weight: 700; color: #ef4444; font-size: 15px; }
                ScrollView {
                    width: 100%;
                    Text { text: error_message; wrap: word-wrap; color: Palette.text-main; width: 374px; font-size: 13px; }
                }
                HorizontalLayout {
                    alignment: end;
                    Rectangle {
                        width: 90px; height: 34px;
                        border-radius: 8px; background: Palette.sidebar;
                        border-width: 1px; border-color: Palette.border;
                        Text { text: "Dismiss"; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; color: Palette.text-sub; }
                        TouchArea { clicked => { show_error_prompt = false; } }
                    }
                }
            }
        }
    }

    // ── Info overlay ────────────────────────────────────────────────────────
    if (show_info_prompt) : Rectangle {
        background: #00000099;
        TouchArea { }

        Rectangle {
            width: 420px; height: 210px;
            border-radius: 12px;
            background: Palette.card;
            border-width: 1px; border-color: Palette.border-light;
            drop-shadow-color: #00000060;
            drop-shadow-blur: 32px; drop-shadow-offset-y: 10px;

            VerticalLayout {
                padding: 24px; spacing: 14px;

                Text { text: "About rTunnel"; font-weight: 700; color: Palette.text-main; font-size: 15px; }
                ScrollView {
                    width: 100%;
                    Text { text: "rTunnel is a robust SSH Tunnel Manager designed to securely route your traffic.\n\nVersion: v0.2.0\nLicense: MIT and Apache 2.0"; wrap: word-wrap; color: Palette.text-sub; width: 374px; font-size: 13px; }
                }
                HorizontalLayout {
                    alignment: end;
                    Rectangle {
                        width: 90px; height: 34px;
                        border-radius: 8px; background: Palette.sidebar;
                        border-width: 1px; border-color: Palette.border;
                        Text { text: "Close"; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; color: Palette.text-sub; }
                        TouchArea { clicked => { show_info_prompt = false; } }
                    }
                }
            }
        }
    }

    // ── Host key prompt overlay ──────────────────────────────────────────────────
    if (show_host_key_prompt) : Rectangle {
        background: #00000099;
        TouchArea { }

        Rectangle {
            width: 460px; height: 260px;
            border-radius: 12px;
            background: Palette.card;
            border-width: 1px; border-color: Palette.border-light;
            drop-shadow-color: #00000060;
            drop-shadow-blur: 32px; drop-shadow-offset-y: 10px;

            VerticalLayout {
                padding: 24px; spacing: 14px;

                Text { text: "Unknown Host Key"; font-weight: 700; color: Palette.text-main; font-size: 15px; }
                Text { text: "The server's host key is unknown or has changed. Do you want to trust it?"; wrap: word-wrap; color: Palette.text-sub; font-size: 13px; }
                Text { text: "Fingerprint (SHA256):"; font-weight: 700; color: Palette.text-main; font-size: 12px; }
                Text { text: prompt_host_key_fingerprint; color: Palette.accent; font-size: 12px; }

                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px; alignment: end;
                    Rectangle {
                        width: 90px; height: 34px;
                        border-radius: 8px; background: Palette.sidebar;
                        border-width: 1px; border-color: Palette.border;
                        Text { text: "Reject"; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; color: Palette.text-sub; }
                        TouchArea { clicked => { reject_host_key(); } }
                    }
                    Rectangle {
                        width: 90px; height: 34px;
                        border-radius: 8px;
                        background: @linear-gradient(135deg, Palette.accent, Palette.accent-dark);
                        Text { text: "Accept"; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; color: white; }
                        TouchArea { clicked => { accept_host_key(prompt_host_key_tunnel_id, prompt_host_key_line, prompt_host_key_is_reconnect); } }
                    }
                }
            }
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("tray_icon.svg");
    tooltip: "rTunnel - SSH Tunnel Manager";

    callback show-window();
    callback quit();
    
    // In Slint, SystemTrayIcon currently only explicitly supports `clicked`, but clicking twice (double clicking) will trigger this and also work fine.
    clicked => { root.show-window(); }

    Menu {
        MenuItem { title: "Show rTunnel"; activated => { show-window(); } }
        MenuItem { title: "Quit"; activated => { quit(); } }
    }
}
